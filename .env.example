# Placeholders only. This file is documentation; no dotenv loader is used.
# Supply these only to the isolated trusted broker, never to an agent process.
IMPLEMENTER_APP_ID=<github-app-id>
IMPLEMENTER_INSTALLATION_ID=<installation-id>
IMPLEMENTER_REPOSITORIES={"puennaja/puen-github-apps":<numeric-repository-id>}
IMPLEMENTER_PERMISSIONS={"metadata":"read","contents":"write","pull_requests":"write"}
IMPLEMENTER_PROTECTED_BRANCHES=["master","main"]
# Operator-controlled PEM source. The CLI supports env:...; a trusted embedding
# may resolve secret://... without putting key bytes in this file or agent context.
IMPLEMENTER_PRIVATE_KEY_SOURCE=secret://implementer/app-private-key
# No private key or installation token is configured or returned by the agent interface.

# Reviewer proposal only. No reviewer App is registered or activated by GOV-003A.
REVIEWER_APP_ID=<github-app-id>
REVIEWER_INSTALLATION_ID=<installation-id>
REVIEWER_REPOSITORIES={"puennaja/puen-github-apps":<numeric-repository-id>}
REVIEWER_PERMISSIONS={"metadata":"read","contents":"read","pull_requests":"read","checks":"write"}
REVIEWER_PRIVATE_KEY_SOURCE=secret://reviewer/app-private-key
REVIEWER_WEBHOOK_SECRET_SOURCE=secret://reviewer/webhook-secret
